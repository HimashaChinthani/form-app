{
  "info": {
    "name": "FormApp API",
    "description": "API collection for the FormApp technical assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "submissionId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"pass1234\",\n  \"confirmPassword\": \"pass1234\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Customer login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"pass1234\"\n}" },
            "url": "{{baseUrl}}/auth/login/customer"
          }
        },
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\"\n}" },
            "url": "{{baseUrl}}/auth/login/admin"
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Create admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"new-admin@example.com\"\n}" },
            "url": "{{baseUrl}}/auth/create-admin"
          }
        }
      ]
    },
    {
      "name": "Submissions",
      "item": [
        {
          "name": "Create submission",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"gender\": \"MALE\",\n  \"mobileNumber\": \"1234567890\",\n  \"address\": \"123 Main Street\",\n  \"feedback\": \"Optional feedback\"\n}" },
            "url": "{{baseUrl}}/submissions"
          }
        },
        {
          "name": "Get submissions with filters",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/submissions?search=john&gender=MALE"
          }
        },
        {
          "name": "Update submission",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"gender\": \"FEMALE\",\n  \"mobileNumber\": \"1234567890\",\n  \"address\": \"456 Main Street\",\n  \"feedback\": \"Updated feedback\"\n}" },
            "url": "{{baseUrl}}/submissions/{{submissionId}}"
          }
        },
        {
          "name": "Delete submission",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/submissions/{{submissionId}}"
          }
        }
      ]
    }
  ]
}
